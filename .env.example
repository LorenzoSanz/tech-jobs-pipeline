# Copy to .env (git-ignored). docker compose and jobpipe read these.
POSTGRES_PASSWORD=jobpipe
GRAFANA_DB_PASSWORD=grafana
GRAFANA_ADMIN_PASSWORD=admin
POSTGRES_PORT=55432
JOBPIPE_DATABASE_URL=postgresql://jobpipe:jobpipe@127.0.0.1:55432/jobpipe

# Optional API keys
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
LEVELS_FYI_API_KEY=
