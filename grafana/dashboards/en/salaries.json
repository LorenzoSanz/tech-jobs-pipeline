          "rawSql": "SELECT CASE role WHEN 'product' THEN 'Product & design' WHEN 'eng_management' THEN 'Engineering management' WHEN 'ml' THEN 'ML / AI' WHEN 'data' THEN 'Data' WHEN 'devops' THEN 'DevOps / SRE / Platform' WHEN 'security' THEN 'Security' WHEN 'mobile' THEN 'Mobile' WHEN 'qa' THEN 'QA / Testing' WHEN 'embedded' THEN 'Embedded / Hardware' WHEN 'fullstack' THEN 'Full-stack' WHEN 'frontend' THEN 'Frontend' WHEN 'backend' THEN 'Backend' WHEN 'engineering' THEN 'Engineering (general)' WHEN 'other' THEN 'Other (non-tech)' ELSE role END AS \"Role\", count(*) AS \"Postings\",\n       percentile_cont(0.25) WITHIN GROUP (ORDER BY midpoint) AS \"p25\",\n       percentile_cont(0.5)  WITHIN GROUP (ORDER BY midpoint) AS \"Median\",\n       percentile_cont(0.75) WITHIN GROUP (ORDER BY midpoint) AS \"p75\"\nFROM gold.salaries WHERE \ncurrency = ${currency:sqlstring}\n  AND coalesce(nullif(regions, '{}'), '{other}') && ARRAY[$region]::text[]\n  AND ('__all' IN ($role) OR role IN ($role))\n  AND (NOT predicted OR ${predicted:raw})\n  AND $__timeFilter(posted_at)\n\nGROUP BY role ORDER BY 4 DESC"
