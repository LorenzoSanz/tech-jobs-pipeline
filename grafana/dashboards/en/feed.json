    {
      "type": "barchart",
      "title": "What you lack most often · % of these postings",
      "description": "Out of the postings above that name at least one technology.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jobpipe-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jobpipe-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT t.label AS \"Technology\",\n       round(100.0 * count(*) / nullif((SELECT count(*) FROM gold.feed WHERE coalesce(nullif(regions, '{}'), '{other}') && ARRAY[$region]::text[]\n  AND ('__all' IN ($role) OR role IN ($role))\n  AND coalesce(score, 0) * 100 >= ${min_match:raw}\n  AND first_seen > now() - interval '1 day' * ${new:raw} AND score IS NOT NULL), 0), 1)\n         AS \"Postings\"\nFROM gold.feed f\nCROSS JOIN LATERAL unnest(f.missing) AS u(key)\nJOIN silver.technologies t USING (key)\nWHERE coalesce(nullif(regions, '{}'), '{other}') && ARRAY[$region]::text[]\n  AND ('__all' IN ($role) OR role IN ($role))\n  AND coalesce(score, 0) * 100 >= ${min_match:raw}\n  AND first_seen > now() - interval '1 day' * ${new:raw}\nGROUP BY t.label ORDER BY 2 DESC, 1 LIMIT 15"
        }
      ],
      "options": {
        "xField": "Technology",
        "orientation": "horizontal",
        "showValue": "auto",
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "barWidth": 0.75,
        "barRadius": 0.2,
        "xTickLabelRotation": 0,
        "tooltip": {
          "mode": "single"
        },
        "stacking": "none"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "—",
          "color": {
            "mode": "continuous-BlPu"
          },
          "custom": {
            "fillOpacity": 90,
            "lineWidth": 0,
            "gradientMode": "scheme"
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 11
      },
      "id": 9
    },
    {
      "type": "barchart",
      "title": "Most asked in these postings",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jobpipe-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jobpipe-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT t.label AS \"Technology\",\n       nullif(count(*) FILTER (WHERE u.key = ANY(f.have)), 0) AS \"You know\",\n       nullif(count(*) FILTER (WHERE u.key = ANY(f.missing)), 0) AS \"You lack\"\nFROM gold.feed f\nCROSS JOIN LATERAL unnest(f.have || f.missing) AS u(key)\nJOIN silver.technologies t USING (key)\nWHERE coalesce(nullif(regions, '{}'), '{other}') && ARRAY[$region]::text[]\n  AND ('__all' IN ($role) OR role IN ($role))\n  AND coalesce(score, 0) * 100 >= ${min_match:raw}\n  AND first_seen > now() - interval '1 day' * ${new:raw}\nGROUP BY t.label ORDER BY count(*) DESC, 1 LIMIT 15"
        }
      ],
