        "definition": "SELECT role AS __value, CASE role WHEN 'product' THEN 'Product & design' WHEN 'eng_management' THEN 'Engineering management' WHEN 'ml' THEN 'ML / AI' WHEN 'data' THEN 'Data' WHEN 'devops' THEN 'DevOps / SRE / Platform' WHEN 'security' THEN 'Security' WHEN 'mobile' THEN 'Mobile' WHEN 'qa' THEN 'QA / Testing' WHEN 'embedded' THEN 'Embedded / Hardware' WHEN 'fullstack' THEN 'Full-stack' WHEN 'frontend' THEN 'Frontend' WHEN 'backend' THEN 'Backend' WHEN 'engineering' THEN 'Engineering (general)' WHEN 'other' THEN 'Other (non-tech)' ELSE role END AS __text FROM gold.feed GROUP BY role ORDER BY count(*) DESC",
