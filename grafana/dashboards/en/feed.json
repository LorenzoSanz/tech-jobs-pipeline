    {
      "type": "table",
      "title": "Click the title to open the posting",
      "description": "Postings that name no known technology have no match and come last. Ranking favours postings that name more of your skills.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jobpipe-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jobpipe-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT round(100 * score) AS \"Match\", title AS \"Title\",\n       company AS \"Company\", coalesce(location, country) AS \"Location\",\n       array_to_string(ARRAY(SELECT t.label FROM unnest(have) WITH ORDINALITY AS u(key, n) JOIN silver.technologies t USING (key) ORDER BY n), ', ') AS \"You know\", array_to_string(ARRAY(SELECT t.label FROM unnest(missing) WITH ORDINALITY AS u(key, n) JOIN silver.technologies t USING (key) ORDER BY n), ', ') AS \"You lack\",\n       to_char(first_seen, 'YYYY-MM-DD') AS \"First seen\", source AS \"Source\", url\nFROM gold.feed\nWHERE coalesce(nullif(regions, '{}'), '{other}') && ARRAY[$region]::text[]\n  AND ('__all' IN ($role) OR role IN ($role))\n  AND coalesce(score, 0) * 100 >= ${min_match:raw}\n  AND first_seen > now() - interval '1 day' * ${new:raw}\nORDER BY rank DESC, cardinality(have) DESC, first_seen DESC\nLIMIT 300"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "—",
          "custom": {
            "align": "auto",
            "filterable": false,
            "inspect": false,
            "minWidth": 70
          }
        },
