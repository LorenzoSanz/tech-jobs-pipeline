          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT source AS \"Fuente\", runs AS \"Ejecuciones\", records AS \"Registros\", to_char(last_ingest, 'YYYY-MM-DD') AS \"Última recogida\",\n       current_date - last_ingest AS \"Días\"\nFROM gold.source_health ORDER BY 1"
