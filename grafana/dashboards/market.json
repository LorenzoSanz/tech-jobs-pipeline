    {
      "type": "timeseries",
      "title": "Ofertas publicadas por mes y región",
      "description": "Fecha de publicación según la fuente; si no la da, la primera vez que se vio. HN aporta la historia desde 2011.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jobpipe-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jobpipe-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT month::timestamptz AS time, region AS metric, sum(postings) AS value\nFROM gold.postings_monthly\nWHERE $__timeFilter(month::timestamptz) AND region IN ($region) AND ('__all' IN ($role) OR role IN ($role))\nGROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
