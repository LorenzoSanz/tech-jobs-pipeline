    {
      "type": "table",
      "title": "Ofertas del periodo · clic en el puesto para abrir la oferta",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jobpipe-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jobpipe-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT to_char(coalesce(p.published, p.first_seen), 'YYYY-MM-DD') AS \"Publicada\", p.company AS \"Empresa\", p.title AS \"Puesto\",\n       p.role AS \"Rol\", coalesce(p.location, p.country) AS \"Lugar\", array_to_string(p.regions, ', ') AS \"Región\",\n       (SELECT string_agg(s.currency || ' ' || round(s.min_annual / 1000) || 'k–' || round(s.max_annual / 1000) || 'k', ' / ')\n          FROM silver.posted_salaries s\n         WHERE s.source = p.source AND s.source_id = p.source_id AND NOT s.predicted) AS \"Salario\",\n       p.source AS \"Fuente\", p.url\nFROM silver.postings p\nWHERE coalesce(nullif(regions, '{}'), '{other}') && ARRAY[$region]::text[]\n  AND ('__all' IN ($role) OR role IN ($role))\n  AND ('__all' IN ($company) OR company IN ($company))\n  AND $__timeFilter(coalesce(p.published, p.first_seen))\n  AND (NOT ${with_salary:raw} OR EXISTS (SELECT 1 FROM silver.posted_salaries s\n        WHERE s.source = p.source AND s.source_id = p.source_id AND NOT s.predicted))\nORDER BY 1 DESC NULLS LAST LIMIT 500"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
