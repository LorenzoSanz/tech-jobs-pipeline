          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT role AS \"Rol\", count(*) AS \"Ofertas\"\nFROM silver.postings\nWHERE last_seen > now() - interval '90 days' AND coalesce(nullif(regions, '{}'), '{other}') && ARRAY[$region]::text[]\n  AND ('__all' IN ($role) OR role IN ($role))\n  AND ('__all' IN ($company) OR company IN ($company))\nGROUP BY 1 ORDER BY 2 DESC"
