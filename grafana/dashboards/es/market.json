    {
      "type": "barchart",
      "title": "Lo más pedido · % de las ofertas del periodo",
      "description": "Sacado del título y la descripción de cada oferta, ver src/jobpipe/tech.py.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jobpipe-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jobpipe-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT t.label AS \"Tecnología\",\n       round(100.0 * count(*) / nullif((SELECT count(*) FROM silver.postings\n                                         WHERE coalesce(nullif(regions, '{}'), '{other}') && ARRAY[$region]::text[]\n  AND ('__all' IN ($role) OR role IN ($role))\n  AND ('__all' IN ($company) OR company IN ($company)) AND $__timeFilter(coalesce(published, first_seen))\n                                        ), 0), 1) AS \"Ofertas\"\nFROM silver.postings p\nCROSS JOIN LATERAL unnest(p.technologies) AS u(key)\nJOIN silver.technologies t USING (key)\nWHERE coalesce(nullif(regions, '{}'), '{other}') && ARRAY[$region]::text[]\n  AND ('__all' IN ($role) OR role IN ($role))\n  AND ('__all' IN ($company) OR company IN ($company)) AND $__timeFilter(coalesce(p.published, p.first_seen))\nGROUP BY t.label ORDER BY 2 DESC, 1 LIMIT 20"
        }
      ],
      "options": {
        "xField": "Tecnología",
        "orientation": "horizontal",
        "showValue": "auto",
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "barWidth": 0.75,
        "barRadius": 0.2,
        "xTickLabelRotation": 0,
        "tooltip": {
          "mode": "single"
