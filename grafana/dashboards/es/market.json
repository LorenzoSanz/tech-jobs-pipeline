          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT month::timestamptz AS time, CASE region WHEN 'ch' THEN 'Suiza' WHEN 'es' THEN 'España' WHEN 'eu' THEN 'Resto de Europa' WHEN 'other' THEN 'Otras / sin región' ELSE region END AS metric, sum(postings) AS value\nFROM gold.postings_monthly\nWHERE $__timeFilter(month::timestamptz) AND region IN ($region) AND ('__all' IN ($role) OR role IN ($role))\nGROUP BY 1, region ORDER BY 1"
