    {
      "type": "table",
      "title": "Ofertas del periodo · clic en el puesto para abrir la oferta",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jobpipe-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jobpipe-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT to_char(coalesce(p.published, p.first_seen), 'YYYY-MM-DD') AS \"Publicada\",\n       p.company AS \"Empresa\", p.title AS \"Puesto\", CASE role WHEN 'product' THEN 'Producto y diseño' WHEN 'eng_management' THEN 'Gestión técnica' WHEN 'ml' THEN 'ML / IA' WHEN 'data' THEN 'Datos' WHEN 'devops' THEN 'DevOps / SRE / Plataforma' WHEN 'security' THEN 'Seguridad' WHEN 'mobile' THEN 'Móvil' WHEN 'qa' THEN 'QA / Test' WHEN 'embedded' THEN 'Embebido / Hardware' WHEN 'fullstack' THEN 'Full-stack' WHEN 'frontend' THEN 'Frontend' WHEN 'backend' THEN 'Backend' WHEN 'engineering' THEN 'Ingeniería (general)' WHEN 'other' THEN 'Otros (no técnicos)' ELSE role END AS \"Rol\",\n       coalesce(p.location, p.country) AS \"Lugar\", (SELECT string_agg(CASE region WHEN 'ch' THEN 'Suiza' WHEN 'es' THEN 'España' WHEN 'eu' THEN 'Resto de Europa' WHEN 'other' THEN 'Otras / sin región' ELSE region END, ', ') FROM unnest(p.regions) AS r(region)) AS \"Región\",\n       (SELECT string_agg(s.currency || ' ' || round(s.min_annual / 1000) || 'k–' || round(s.max_annual / 1000) || 'k', ' / ')\n          FROM silver.posted_salaries s\n         WHERE s.source = p.source AND s.source_id = p.source_id AND NOT s.predicted) AS \"Salario\",\n       p.source AS \"Fuente\", p.url\nFROM silver.postings p\nWHERE coalesce(nullif(regions, '{}'), '{other}') && ARRAY[$region]::text[]\n  AND ('__all' IN ($role) OR role IN ($role))\n  AND ('__all' IN ($company) OR company IN ($company))\n  AND $__timeFilter(coalesce(p.published, p.first_seen))\n  AND (NOT ${with_salary:raw} OR EXISTS (SELECT 1 FROM silver.posted_salaries s\n        WHERE s.source = p.source AND s.source_id = p.source_id AND NOT s.predicted))\nORDER BY 1 DESC NULLS LAST LIMIT 500"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "—",
