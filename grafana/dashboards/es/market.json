          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('month', coalesce(p.published, p.first_seen)) AS time, t.label AS metric,\n       100.0 * count(*) FILTER (WHERE t.key = ANY(p.technologies)) / count(*) AS value\nFROM silver.postings p\nCROSS JOIN silver.technologies t\nWHERE t.key IN ($technology) AND coalesce(nullif(regions, '{}'), '{other}') && ARRAY[$region]::text[]\n  AND ('__all' IN ($role) OR role IN ($role))\n  AND ('__all' IN ($company) OR company IN ($company)) AND $__timeFilter(coalesce(p.published, p.first_seen))\nGROUP BY 1, 2 HAVING count(*) >= 10 ORDER BY 1"
