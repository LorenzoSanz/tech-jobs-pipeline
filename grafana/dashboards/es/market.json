          "rawSql": "SELECT company AS \"Empresa\", count(*) AS \"Ofertas\",\n       to_char(max(coalesce(published, first_seen)), 'YYYY-MM-DD') AS \"Última\"\nFROM silver.postings\nWHERE company IS NOT NULL AND last_seen > now() - interval '90 days' AND coalesce(nullif(regions, '{}'), '{other}') && ARRAY[$region]::text[]\n  AND ('__all' IN ($role) OR role IN ($role))\n  AND ('__all' IN ($company) OR company IN ($company))\nGROUP BY 1 ORDER BY 2 DESC LIMIT 50"
