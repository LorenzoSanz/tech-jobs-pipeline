        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "jobpipe-pg"
        },
        "query": "SELECT seniority AS __value, CASE seniority WHEN 'intern' THEN 'Prácticas / becario' WHEN 'head' THEN 'Head / dirección' WHEN 'lead' THEN 'Lead / staff / principal' WHEN 'senior' THEN 'Senior' WHEN 'junior' THEN 'Junior' WHEN 'mid' THEN 'Intermedio' WHEN 'unspecified' THEN 'Sin indicar' ELSE seniority END AS __text FROM gold.salaries GROUP BY seniority ORDER BY array_position(ARRAY['intern', 'head', 'lead', 'senior', 'junior', 'mid', 'unspecified'], seniority)",
        "definition": "SELECT seniority AS __value, CASE seniority WHEN 'intern' THEN 'Prácticas / becario' WHEN 'head' THEN 'Head / dirección' WHEN 'lead' THEN 'Lead / staff / principal' WHEN 'senior' THEN 'Senior' WHEN 'junior' THEN 'Junior' WHEN 'mid' THEN 'Intermedio' WHEN 'unspecified' THEN 'Sin indicar' ELSE seniority END AS __text FROM gold.salaries GROUP BY seniority ORDER BY array_position(ARRAY['intern', 'head', 'lead', 'senior', 'junior', 'mid', 'unspecified'], seniority)",
